<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- TestFlight / App Store distribution export. Signing certs and the
       distribution profile are created automatically by xcodebuild using the
       App Store Connect API key (see scripts/testflight_release.sh), so no
       Apple ID needs to be signed into the Xcode GUI. -->
  <key>method</key>
  <string>app-store-connect</string>
  <key>teamID</key>
  <string>ZAR4A6G772</string>
  <key>signingStyle</key>
  <string>automatic</string>
  <key>destination</key>
  <string>export</string>
  <key>uploadSymbols</key>
  <true/>
  <key>manageAppVersionAndBuildNumber</key>
  <false/>
</dict>
</plist>
