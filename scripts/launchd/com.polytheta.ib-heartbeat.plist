<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.polytheta.ib-heartbeat</string>
	<!-- Mac clock is fixed GMT-6. Entry window is 09:45-10:30 ET, i.e. 07:45 local (EDT)
	     or 08:45 local (EST). All three triggers land before the window in both seasons.
	     Sunday evening gives a full night to fix IB; Monday runs are last-call reminders. -->
	<key>StartCalendarInterval</key>
	<array>
		<dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>18</integer><key>Minute</key><integer>0</integer></dict>
		<dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
		<dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>15</integer></dict>
	</array>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/node</string>
		<string>/Users/andrewblount/Library/CloudStorage/Dropbox-BlueCielo/Andrew Blount/development/polytheta/scripts/ib_heartbeat.mjs</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/andrewblount/Library/CloudStorage/Dropbox-BlueCielo/Andrew Blount/development/polytheta</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>StandardOutPath</key>
	<string>/Users/andrewblount/Library/Logs/polytheta/ib-heartbeat.out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/andrewblount/Library/Logs/polytheta/ib-heartbeat.err.log</string>
	<key>WakeSystem</key>
	<true/>
</dict>
</plist>
