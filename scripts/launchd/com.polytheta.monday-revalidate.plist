<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.polytheta.monday-revalidate</string>

  <!-- Drift check a while after the post-open build (build fires 07:45
       local): re-quote the basket and flag entries whose assumptions moved.
       Times are LOCAL (Mac runs fixed GMT-6). -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>10</integer>
      <key>Minute</key><integer>30</integer>
    </dict>
  </array>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/andrewblount/Dropbox/development/polytheta/scripts/verify_basket_live.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/andrewblount/Dropbox/development/polytheta</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key>
  <string>/Users/andrewblount/Dropbox/development/polytheta/scripts/launchd/monday-revalidate.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/andrewblount/Dropbox/development/polytheta/scripts/launchd/monday-revalidate.err.log</string>
  <key>WakeSystem</key><true/>
</dict>
</plist>
