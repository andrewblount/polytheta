<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.polytheta.weekly-basket</string>

  <!-- Fires Monday 07:45 local (09:45 ET) with an 09:00 retry — AFTER the
       open, on purpose. The 2026-07-27 pre-dawn run produced a zero-pick
       basket because Yahoo zeroes option bids overnight: strikes simply
       cannot be selected before ~9:30 ET on Monday. Post-open the build gets
       live bids, live prices, and the morning's news in one pass. Chains
       take ~15-40 min, so the basket lands ~10:15-10:30 ET — matching the
       spec's "Monday morning after any hope rally" entry. The orchestrator
       is idempotent; the retry fast-forwards when the first run finished.
       Times are LOCAL (Mac runs fixed GMT-6). -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>7</integer>
      <key>Minute</key><integer>45</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>9</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
  </array>

  <!-- Full path to node + orchestrator. Update NODE_BIN if `which node`
       reports a different path on this Mac. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/andrewblount/Local/development/polytheta/scripts/run_weekly_basket.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/andrewblount/Local/development/polytheta</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>RunAtLoad</key><false/>

  <!-- Logs stream to the basket data dir per run; these are the launchd-level
       stdout/stderr for the process. -->
  <key>StandardOutPath</key>
  <string>/Users/andrewblount/Local/development/polytheta/scripts/launchd/weekly-basket.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/andrewblount/Local/development/polytheta/scripts/launchd/weekly-basket.err.log</string>

  <!-- If launchd is asked to run this while the Mac is asleep, wake so the
       job actually fires. -->
  <key>WakeSystem</key><true/>
</dict>
</plist>
