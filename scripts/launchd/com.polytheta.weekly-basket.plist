<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.polytheta.weekly-basket</string>

  <!-- Fires Monday 04:00 local (06:00 ET) with an 06:15 retry — the
       orchestrator is idempotent, so the retry fast-forwards if the first
       run completed. Monday pre-dawn beats Sunday evening: option chains are
       frozen at Friday's close all weekend anyway, while Monday premarket
       carries live equity prices (catches weekend gaps before entry — see
       the FCEL autopsy) and the news radar sees Sunday-night M&A
       announcements before the basket is picked. Chains for the full
       universe take ~30-45 min, done well before the open; the 07:35/08:35
       revalidation job remains the post-open gate. Times are LOCAL
       (Mountain assumed, ET-2 year-round). -->
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>4</integer>
      <key>Minute</key><integer>0</integer>
    </dict>
    <dict>
      <key>Weekday</key><integer>1</integer>
      <key>Hour</key><integer>6</integer>
      <key>Minute</key><integer>15</integer>
    </dict>
  </array>

  <!-- Full path to node + orchestrator. Update NODE_BIN if `which node`
       reports a different path on this Mac. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/andrewblount/Local/development/polytheta/scripts/run_weekly_basket.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/andrewblount/Local/development/polytheta</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>RunAtLoad</key><false/>

  <!-- Logs stream to the basket data dir per run; these are the launchd-level
       stdout/stderr for the process. -->
  <key>StandardOutPath</key>
  <string>/Users/andrewblount/Local/development/polytheta/scripts/launchd/weekly-basket.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/andrewblount/Local/development/polytheta/scripts/launchd/weekly-basket.err.log</string>

  <!-- If launchd is asked to run this while the Mac is asleep, wake so the
       job actually fires. -->
  <key>WakeSystem</key><true/>
</dict>
</plist>
