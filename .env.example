# Polytheta Environment Variables Template
# Copy this to .env.local and configure with your actual values
# NEVER commit .env.local or any file containing real credentials to Git

# ============================================
# Application
# ============================================

# Public app URL (automatically set by Netlify in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL=https://yoursite.netlify.app
# DEPLOY_PRIME_URL=

# Session secret for server-side sessions (generate a random string)
# SESSION_SECRET=

# ============================================
# Database (Neon PostgreSQL via @netlify/neon)
# ============================================

# Primary database connection URL (pooled)
# Netlify automatically provisions this when using @netlify/neon
NETLIFY_DATABASE_URL=

# Alternative database URL (if not using Netlify's env var name)
# DATABASE_URL=

# Direct/unpooled connection URL (for migrations and specific operations)
# NETLIFY_DATABASE_URL_UNPOOLED=

# Worker-specific direct database connection (for singleton execution lock)
# Defaults to converting NETLIFY_DATABASE_URL to direct endpoint
# IBKR_WORKER_DATABASE_URL=

# ============================================
# Authentication & Security
# ============================================

# Internal sync token for scheduled functions and API endpoints
INTERNAL_SYNC_TOKEN=

# Bearer token for mobile API authentication (iOS app)
MOBILE_API_TOKEN=

# ============================================
# Email Notifications
# ============================================

# SendGrid API key for sending emails
# SENDGRID_API_KEY=

# Email address to send from
# SENDGRID_FROM_EMAIL=

# Email address to receive access requests and alerts
ACCESS_REQUEST_NOTIFY_EMAIL=ablount@bluecielo.com

# Email address to receive stop/alert notifications
# STOP_ALERT_EMAIL=

# ============================================
# Interactive Brokers (ALPHA/UNVERIFIED)
# WARNING: IB integration has never been tested with live accounts
# ============================================

# IB account ID (exact live account to access; no paper account)
# IBKR_ACCOUNT_ID=

# TWS/Gateway connection settings
# IBKR_TWS_HOST=127.0.0.1
# IBKR_TWS_PORT=4001
# IBKR_TWS_CLIENT_ID=96

# Set to UTC only if TWS API execution timestamps are configured as UTC
# IBKR_TWS_TIME_ZONE=

# Corporate service token for Web API authentication (if using bearer token flow)
# IBKR_ACCESS_TOKEN=

# Web API base URL (for gateway/service connections)
# IBKR_WEB_API_URL=https://localhost:5000/v1/api

# Set to 'true' ONLY for local gateway with self-signed certificate
# IBKR_LOCAL_GATEWAY_INSECURE=

# Operator-controlled activation (must be 'true' to enable order execution)
# Absent or 'false' means broker reads only
# POLYTHETA_EXECUTION_ENABLED=

# ============================================
# Schwab Integration
# ============================================

# Schwab API credentials
# SCHWAB_APP_KEY=
# SCHWAB_APP_SECRET=
# SCHWAB_REFRESH_TOKEN=

# Schwab API base URL
# SCHWAB_API_BASE=https://api.schwabapi.com

# ============================================
# SMS/WhatsApp Alerts (Twilio)
# ============================================

# Twilio account credentials
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Twilio phone numbers
# TWILIO_FROM_NUMBER=
# TWILIO_WHATSAPP_FROM=

# Recipient phone number for alerts
# ALERT_SMS_TO=

# ============================================
# iMessage Alerts (macOS only)
# ============================================

# Recipient phone/email for iMessage alerts
# ALERT_IMESSAGE_TO=

# ============================================
# Demo Mode (UI development without database)
# ============================================

# Enable demo mode with fake data (bypasses authentication)
# POLYTHETA_DEMO_MODE=true

# Demo role: 'admin' or 'member'
# POLYTHETA_DEMO_ROLE=admin

# Demo user emails (optional overrides)
# DEMO_ADMIN_EMAIL=
# DEMO_MEMBER_EMAIL=

# ============================================
# API & Development
# ============================================

# Base URL for PolyTheta API (for external scripts)
# POLYTHETA_API_BASE=https://polytheta.com

# Model equity for backtesting/analysis (default: 1000000)
# POLYTHETA_MODEL_EQUITY=1000000

# ============================================
# Apple App Store Connect (for iOS deployment)
# ============================================

# App Store Connect API credentials for TestFlight releases
# ASC_KEY_ID=
# ASC_ISSUER_ID=
